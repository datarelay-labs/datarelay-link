#!/usr/bin/env python3
from __future__ import annotations
import argparse
import getpass
import os
import sys
from pathlib import Path

SOURCE_LIB = Path(__file__).resolve().parents[1] / "lib"
INSTALLED_LIB = Path("/usr/local/lib/drlink")
if (SOURCE_LIB / "drlink_web_auth.py").is_file():
    sys.path.insert(0, str(SOURCE_LIB))
elif INSTALLED_LIB.is_dir():
    sys.path.insert(0, str(INSTALLED_LIB))
else:
    sys.path.insert(0, str(SOURCE_LIB))

from drlink_control_db import ControlPlaneError
from drlink_web_auth import WebAuthService


def main() -> int:
    parser = argparse.ArgumentParser(description="Bootstrap the first local Data Relay Link Web Admin")
    parser.add_argument("--username", default="admin")
    parser.add_argument("--root")
    args = parser.parse_args()
    if os.geteuid() != 0 and not args.root:
        print("ERROR: privileged local bootstrap requires root.", file=sys.stderr)
        return 2
    try:
        with WebAuthService(args.root) as auth:
            if auth.has_operator():
                raise ControlPlaneError("A Web operator already exists; use local recovery/admin management.")
            password = getpass.getpass("New Web Admin password: ")
            confirm = getpass.getpass("Confirm password: ")
            if password != confirm:
                raise ControlPlaneError("Passwords do not match.")
            result = auth.create_first_admin(
                username=args.username,
                password=password,
            )
            print("\nWEB_ADMIN_BOOTSTRAP=PASS")
            print("USERNAME=%s" % result["username"])
            print("ROLE=%s" % result["role"])
            print("MFA_REQUIRED=NO")
            print("MFA can be enabled per user from Web Management > Users.")
            return 0
    except (ControlPlaneError, OSError, ValueError) as exc:
        print("ERROR: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

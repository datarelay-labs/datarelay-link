#!/usr/bin/env python3
"""Set the Zero-Touch Agent installer URL (fail closed).

Requires HTTPS. Rejects userinfo, control characters, whitespace tricks,
malformed URLs, and unsupported schemes. Uses the server lifecycle lock
and atomic config writes.

Usage:
  frp-set-client-installer-url <https-url>
  frp-set-client-installer-url --windows <https-url>
  frp-set-client-installer-url --unset
  frp-set-client-installer-url --windows --unset
"""
from __future__ import annotations

import importlib.util
import ipaddress
import os
import re
import sys
from pathlib import Path
from urllib.parse import urlsplit


def fail(message: str) -> None:
    print('ERROR: %s' % message, file=sys.stderr)
    raise SystemExit(1)


def _load(name, rel):
    here = Path(__file__).resolve()
    root = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')
    candidates = [
        here.parent.parent / 'lib' / rel,
        Path('/usr/local/lib/drlink') / rel,
    ]
    if root:
        candidates.insert(1, Path(root) / 'usr/local/lib/drlink' / rel)
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location(name, str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise RuntimeError('%s is unavailable' % rel)


def validate_https_installer_url(url: str) -> str:
    if url is None:
        fail('Agent installer URL is required')
    if not isinstance(url, str):
        fail('Agent installer URL must be a string')
    if url.strip() != url:
        fail('Agent installer URL must not have leading/trailing whitespace')
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in url):
        fail('Agent installer URL must not contain control characters')
    if any(ch.isspace() for ch in url):
        fail('Agent installer URL must not contain whitespace')
    try:
        parsed = urlsplit(url)
        port = parsed.port
    except (TypeError, ValueError):
        fail('Agent installer URL is malformed')
    if parsed.scheme != 'https':
        fail('Agent installer URL must use https')
    host = parsed.hostname
    if not host:
        fail('Agent installer URL hostname is required')
    # Reject invalid URLs before config mutation, using the canonical Server
    # hostname validation and retaining valid private-IP/local test endpoints.
    try:
        ipaddress.ip_address(host)
    except ValueError:
        if re.fullmatch(r'[0-9.]+', host):
            fail('Agent installer URL hostname is not a valid IP address')
        if host != 'localhost':
            server_config = _load('frp_server_config', 'frp_server_config.py')
            try:
                server_config.validate_public_hostname(host, required=True)
            except server_config.ConfigError:
                fail('Agent installer URL has an invalid DNS hostname')
    if parsed.netloc.endswith(':'):
        fail('Agent installer URL port is invalid')
    if parsed.username is not None or parsed.password is not None:
        fail('Agent installer URL must not contain embedded credentials')
    if port is not None and not (1 <= port <= 65535):
        fail('Agent installer URL port is invalid')
    if not parsed.path or parsed.path == '/':
        fail('Agent installer URL path is required')
    return url


def main(argv=None):
    fail("Installer URL overrides are retired. DRLink uses qualified Server-local Agent artifacts automatically.")


if __name__ == '__main__':
    raise SystemExit(main())

#!/usr/bin/env bash
# Canonical Data Relay Link operator CLI.
# Internal dispatcher remains tools/frpctl (not installed on PATH).
set -euo pipefail

# The private backend RPC is used only by REPL inventory refresh. It must not
# bypass the canonical grammar through the public frontend.
if [[ "${1:-}" == "--print-grammar-payload" ]]; then
  echo "ERROR: that option is not a public Data Relay Link command." >&2
  echo "Use: drlink help commands" >&2
  exit 2
fi

export FRP_CTL_CMD_NAME="drlink"
export FRP_CTL_PROMPT="drlink> "
export FRP_CTL_PRODUCT_NAME="${FRP_CTL_PRODUCT_NAME:-Data Relay Link}"
export FRP_CTL_PRODUCT_FAMILY="${FRP_CTL_PRODUCT_FAMILY:-Data Relay Link Management}"

_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_ROOT="${FRP_CTL_TEST_ROOT:-${FRP_CLIENT_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-${FRP_UPDATE_ROOT:-}}}}"
_BACKEND=""

if [[ -f "${_HERE}/frpctl" ]]; then
  _BACKEND="${_HERE}/frpctl"
elif [[ -n "${_ROOT}" && -f "${_ROOT}/usr/local/lib/drlink/frpctl" ]]; then
  _BACKEND="${_ROOT}/usr/local/lib/drlink/frpctl"
elif [[ -f /usr/local/lib/drlink/frpctl ]]; then
  _BACKEND=/usr/local/lib/drlink/frpctl
elif [[ -f '/Library/Application Support/drlink/lib/frpctl' ]]; then
  _BACKEND='/Library/Application Support/drlink/lib/frpctl'
fi

if [[ "$EUID" -ne 0 ]]; then
  _PROTECTED_BACKEND=0
  if [[ -n "${_BACKEND}" && ! -r "${_BACKEND}" ]]; then
    _PROTECTED_BACKEND=1
  fi
  if [[ -z "${_BACKEND}" ]]; then
    for _DIR in "${_ROOT}/usr/local/lib/drlink" /usr/local/lib/drlink \
      '/Library/Application Support/drlink' '/Library/Application Support/drlink/lib'; do
      if [[ -d "${_DIR}" && ! -x "${_DIR}" ]]; then _PROTECTED_BACKEND=1; fi
    done
  fi
  if [[ "${_PROTECTED_BACKEND}" -eq 1 ]]; then
    echo 'ERROR: administrator privileges are required to access the protected Data Relay Link CLI installation.' >&2
    echo 'Run: sudo drlink' >&2
    exit 1
  fi
fi

if [[ -z "${_BACKEND}" ]]; then
  echo "ERROR: Data Relay Link CLI backend is missing (expected frpctl under lib/drlink)." >&2
  exit 1
fi

exec bash "${_BACKEND}" "$@"

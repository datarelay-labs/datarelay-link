#!/usr/bin/env python3
from __future__ import annotations
import argparse
import getpass
import os
import sys
from pathlib import Path

SOURCE_LIB = Path(__file__).resolve().parents[1] / "lib"
INSTALLED_LIB = Path("/usr/local/lib/drlink")
if (SOURCE_LIB / "drlink_web_auth.py").is_file():
    sys.path.insert(0, str(SOURCE_LIB))
elif INSTALLED_LIB.is_dir():
    sys.path.insert(0, str(INSTALLED_LIB))
else:
    sys.path.insert(0, str(SOURCE_LIB))

from drlink_control_db import ControlPlaneError
from drlink_web_auth import (
    ROLE_ADMIN,
    ROLE_OPERATOR,
    ROLE_READ_ONLY,
    WebAuthService,
)


def main() -> int:
    parser = argparse.ArgumentParser(description="Privileged local Web operator management")
    parser.add_argument("--root")
    sub = parser.add_subparsers(dest="command", required=True)
    add = sub.add_parser("add")
    add.add_argument("username")
    add.add_argument("--role", choices=(ROLE_ADMIN, ROLE_OPERATOR, ROLE_READ_ONLY), default=ROLE_READ_ONLY)
    sub.add_parser("list")
    args = parser.parse_args()
    if os.geteuid() != 0 and not args.root:
        print("ERROR: Web operator management requires root.", file=sys.stderr)
        return 2
    try:
        with WebAuthService(args.root) as auth:
            if args.command == "list":
                rows = auth.conn.execute(
                    "SELECT username,role,enabled,recovery_admin,mfa_required,mfa_enrolled,last_login_at "
                    "FROM web_operators ORDER BY username COLLATE NOCASE"
                ).fetchall()
                for row in rows:
                    print(
                        "%s\t%s\t%s\t%s\t%s\t%s"
                        % (
                            row["username"],
                            row["role"],
                            "enabled" if int(row["enabled"] or 0) else "disabled",
                            "recovery-admin" if int(row["recovery_admin"] or 0) else "-",
                            (
                                "mfa-active"
                                if int(row["mfa_required"] or 0) and int(row["mfa_enrolled"] or 0)
                                else "mfa-pending"
                                if int(row["mfa_required"] or 0)
                                else "mfa-off"
                            ),
                            row["last_login_at"] or "-",
                        )
                    )
                return 0
            password = getpass.getpass("New operator password: ")
            confirm = getpass.getpass("Confirm password: ")
            if password != confirm:
                raise ControlPlaneError("Passwords do not match.")
            result = auth.create_operator_local(
                username=args.username,
                role=args.role,
                password=password,
            )
            print("\nWEB_OPERATOR_ADD=PASS")
            print("USERNAME=%s" % result["username"])
            print("ROLE=%s" % result["role"])
            print("MFA_REQUIRED=NO")
            print("MFA can be enabled per user by a Web Admin.")
            return 0
    except (ControlPlaneError, OSError, ValueError) as exc:
        print("ERROR: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

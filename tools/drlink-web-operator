#!/usr/bin/env python3
from __future__ import annotations
import argparse
import getpass
import os
import sys
from pathlib import Path

LIB = Path("/usr/local/lib/drlink")
if LIB.is_dir():
    sys.path.insert(0, str(LIB))
else:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from drlink_control_db import ControlPlaneError
from drlink_web_auth import (
    ROLE_ADMIN,
    ROLE_OPERATOR,
    ROLE_READ_ONLY,
    WebAuthService,
)


def main() -> int:
    parser = argparse.ArgumentParser(description="Privileged local Web operator management")
    parser.add_argument("--root")
    sub = parser.add_subparsers(dest="command", required=True)
    add = sub.add_parser("add")
    add.add_argument("username")
    add.add_argument("--role", choices=(ROLE_ADMIN, ROLE_OPERATOR, ROLE_READ_ONLY), default=ROLE_READ_ONLY)
    sub.add_parser("list")
    args = parser.parse_args()
    if os.geteuid() != 0 and not args.root:
        print("ERROR: Web operator management requires root.", file=sys.stderr)
        return 2
    try:
        with WebAuthService(args.root) as auth:
            if args.command == "list":
                rows = auth.conn.execute(
                    "SELECT username,role,enabled,recovery_admin,last_login_at "
                    "FROM web_operators ORDER BY username COLLATE NOCASE"
                ).fetchall()
                for row in rows:
                    print(
                        "%s\t%s\t%s\t%s\t%s"
                        % (
                            row["username"],
                            row["role"],
                            "enabled" if int(row["enabled"] or 0) else "disabled",
                            "recovery-admin" if int(row["recovery_admin"] or 0) else "-",
                            row["last_login_at"] or "-",
                        )
                    )
                return 0
            password = getpass.getpass("New operator password: ")
            confirm = getpass.getpass("Confirm password: ")
            if password != confirm:
                raise ControlPlaneError("Passwords do not match.")
            material = auth.prepare_mfa_material(args.username)
            print("\nTOTP setup URI (displayed once):")
            print(material["otpauth_uri"])
            print("\nTOTP secret (displayed once):")
            print(material["totp_secret"])
            print("\nRecovery codes (displayed once):")
            for code in material["recovery_codes"]:
                print(code)
            supplied = input("\nEnter a current 6-digit TOTP code: ").strip()
            result = auth.create_operator_local(
                username=args.username,
                role=args.role,
                password=password,
                totp_secret=material["totp_secret"],
                recovery_codes=material["recovery_codes"],
                totp_value=supplied,
            )
            print("\nWEB_OPERATOR_ADD=PASS")
            print("USERNAME=%s" % result["username"])
            print("ROLE=%s" % result["role"])
            return 0
    except (ControlPlaneError, OSError, ValueError) as exc:
        print("ERROR: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""List and show server-owned Managed Host Groups."""
import argparse
import importlib.util
import json
import os
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')


def load_creg():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_client_registry.py',
        Path(ROOT) / 'usr/local/lib/drlink/frp_client_registry.py' if ROOT else None,
        Path('/usr/local/lib/drlink/frp_client_registry.py'),
    ]
    for path in candidates:
        if path is not None and path.is_file():
            spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_client_registry.py')


CREG = load_creg()


def load_state():
    cfg = json.loads(Path(ROOT + '/etc/drlink/config.json').read_text())
    reg = Path(cfg['registry_file'])
    if ROOT and not str(reg).startswith(ROOT):
        reg = Path(ROOT + str(reg))
    if not reg.exists():
        raise SystemExit(
            'ERROR: registry.json is missing (authoritative registry state required)'
        )
    try:
        state = json.loads(reg.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit('ERROR: unable to read registry.json: %s' % exc)
    if state.get('schema_version') != 2:
        raise SystemExit('ERROR: unsupported registry schema version')
    try:
        CREG.ensure_groups_map(state)
        CREG.validate_group_invariants(state)
    except ValueError as exc:
        raise SystemExit('ERROR: %s' % exc)
    return state


def list_groups(state):
    print('%-14s %-24s %13s' % ('GROUP ID', 'NAME', 'MANAGED HOSTS'))
    print('-' * 54)
    for name in (CREG.SYSTEM_GROUP_ALL, CREG.SYSTEM_GROUP_UNGROUPED):
        print('%-14s %-24s %13d' % ('-', name, CREG.group_member_count(state, name)))
    for gid, group in CREG.sorted_groups(state):
        print('%-14s %-24s %13d' % (
            CREG.sanitize_display(gid, 14),
            CREG.sanitize_display(group.get('name') or '-', 24),
            CREG.group_member_count(state, gid),
        ))


def show_group(state, selector):
    gid, group = CREG.resolve_group_or_exit(state, selector)
    print('Group ID      : %s' % ('-' if gid in CREG.RESERVED_GROUP_NAMES else gid))
    print('Name          : %s' % CREG.sanitize_display(group.get('name') or '-', 64))
    print('Description   : %s' % (
        CREG.sanitize_display(group.get('description') or '-', 1024) or '-'
    ))
    members = CREG.clients_in_group(state, gid)
    print('Managed Hosts : %s' % len(members))
    print()
    if not members:
        print('No Managed Hosts in this group.')
        return
    rows = [(CREG.sanitize_display(mid),
             CREG.sanitize_display(client.get('label') or '-'),
             CREG.sanitize_display(client.get('hostname') or '-'))
            for mid, client in members]
    id_width = max(10, *(len(row[0]) for row in rows))
    label_width = max(10, *(len(row[1]) for row in rows))
    for mid, label, hostname in [('HOST ID', 'NAME', 'HOSTNAME')] + rows:
        print('%-*s  %-*s  %s' % (id_width, mid, label_width, label, hostname))


def main():
    parser = argparse.ArgumentParser(description='Show Managed Host Groups')
    parser.add_argument('selector', nargs='?')
    args = parser.parse_args()
    state = load_state()
    if args.selector:
        show_group(state, args.selector)
    else:
        list_groups(state)


if __name__ == '__main__':
    try:
        main()
    except BrokenPipeError:
        pass

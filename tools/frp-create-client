def derive_sha256sums_url(installer_url):
    zt = load_zero_touch()
    if zt is not None:
        try:
            return zt.sha256sums_url_for_installer(installer_url)
        except ValueError:
            return ''
    url = str(installer_url or '').strip()
    if '/artifacts/' in url:
        return url.split('/artifacts/', 1)[0] + '/artifacts/SHA256SUMS'
    suffix = '/dist/bootstrap-client.ps1'
    if url.endswith(suffix):
        return url[:-len(suffix)] + '/SHA256SUMS'
    return ''


def load_services_file(path):
    raw_path = Path(path)
    if not raw_path.is_file():
        fail('services file is missing: %s' % path)
    try:
        data = json.loads(raw_path.read_text(encoding='utf-8'))
    except (OSError, json.JSONDecodeError):
        fail('services file is not valid JSON')
    if not isinstance(data, list):
        fail('services file must contain a JSON list')
    return data


def first_ssh_preflight(services):
    for item in services:
        if not isinstance(item, dict):
            continue
        if str(item.get('preset') or '').strip().lower() != 'ssh':
            continue
        port = coerce_port(item.get('local_port')) or 22
        return port
    return 22


def is_interactive_stdin():
    if 'FRP_CREATE_CLIENT_TEST_INPUT' in os.environ:
        return True
    try:
        return sys.stdin.isatty()
    except Exception:
        return False


def test_input_lines():
    global _TEST_INPUT_LINES
    if _TEST_INPUT_LINES is None:
        raw = os.environ.get('FRP_CREATE_CLIENT_TEST_INPUT')
        if raw is None:
            _TEST_INPUT_LINES = False
        else:
            _TEST_INPUT_LINES = iter(raw.splitlines())
    return _TEST_INPUT_LINES


def read_prompt(prompt):
    lines = test_input_lines()
    if lines is not False:
        sys.stdout.write(prompt)
        sys.stdout.flush()
        try:
            value = next(lines)
        except StopIteration:
            fail('required interactive input was not completed')
        sys.stdout.write(value + '\n')
        sys.stdout.flush()
        return value
    try:
        stderr_tty = sys.stderr.isatty()
        stdout_tty = sys.stdout.isatty()
    except Exception:
        stderr_tty = False
        stdout_tty = False
    try:
        # GNU readline writes input() prompts to stderr. When a parent (the
        # REPL via frpctl_run) captures stderr for sanitizing, that prompt is
        # dumped after the child exits and glues onto the next `drlink>` line.
        # Force the prompt onto the live stdout TTY in that case.
        if stdout_tty and not stderr_tty:
            sys.stdout.write(prompt)
            sys.stdout.flush()
            return input()
        # Always pass the prompt to input()/readline so Backspace cannot walk
        # into a separately written prompt prefix.
        return input(prompt)
    except EOFError:
        fail('required interactive input was not completed')


def validate_prompt_label(raw):
    text = '' if raw is None else str(raw).strip()
    if not text:
        return '', 'Managed Host name cannot be blank.'
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in text):
        return '', 'Managed Host name must not contain control characters or newlines'
    if len(text) > 64:
        return '', 'Managed Host name must be at most 64 characters'
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._ -]{0,63}', text):
        return '', 'invalid Managed Host name'
    return text, ''


def prompt_client_identification(existing_name, existing_note):
    print()
    print('Managed Host details')
    print('====================')
    print()
    print('Enter a name that will help you identify this machine later.')
    print()

    name = '' if existing_name is None else str(existing_name).strip()
    if not name:
        while True:
            entered = read_prompt('Managed Host name: ')
            name, err = validate_prompt_label(entered)
            if name:
                break
            sys.stderr.write('ERROR: %s\n' % err)

    # None means "not collected yet"; empty string means "explicitly blank".
    if existing_note is None:
        entered = read_prompt('Description [optional]: ')
        note = '' if entered is None else str(entered).strip()
        if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in note):
            fail('Description must not contain control characters or newlines')
        if len(note) > 1024:
            fail('Description must be at most 1024 characters')
    else:
        note = str(existing_note)
    return name, note


def _enrollment_track_hints(tracking_id=''):
    """Canonical enrollment guidance; REPL vs shell-aware."""
    repl = str(os.environ.get('FRP_CTL_REPL') or '').strip() == '1'
    tid = str(tracking_id or '<ID>').strip() or '<ID>'
    prefix = '' if repl else 'sudo drlink '
    lines = [
        'Enrollment lifecycle:',
        '  %sshow enrollments' % prefix,
        '  %sunset enrollment %s' % (prefix, tid),
        '',
        'Active enrollment:',
        '  unset revokes it.',
        '',
        'Completed, expired or revoked enrollment:',
        '  unset removes the retained record.',
    ]
    return lines


def print_client_configuration(name, note, services=None, ssh_port=None):
    print()
    print('Managed Host configuration')
    print('==========================')
    print()
    print('Managed Host name : %s' % (name or '(hostname after enrollment)'))
    print('Description : %s' % (note or '-'))
    print()
    print('Services')
    print('--------')
    print()
    rows = list(services or [])
    if not rows and ssh_port:
        rows = [{
            'preset': 'ssh',
            'name': 'SSH',
            'local_ip': '127.0.0.1',
            'local_port': ssh_port or 22,
        }]
    if not rows:
        print('(none — management registration only)')
        print()
        return
    for svc in rows:
        preset = str(svc.get('preset') or '').strip().lower()
        title = str(svc.get('name') or svc.get('id') or preset or 'Service').strip()
        if preset == 'ssh' or str(svc.get('id') or '').lower() == 'ssh':
            title = 'SSH'
        elif preset == 'https':
            title = 'HTTPS'
        elif preset == 'http':
            title = 'HTTP'
        elif preset == 'rdp':
            title = 'RDP'
        host = svc.get('local_ip') or svc.get('target_host') or '127.0.0.1'
        port = svc.get('local_port') or svc.get('target_port') or '-'
        print(title)
        print('  Target   : %s:%s' % (host, port))
        print()



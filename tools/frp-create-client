            here = Path(__file__).resolve()
            for path in (
                here.parent.parent / 'lib' / 'frp_audit.py',
                Path('/usr/local/lib/drlink/frp_audit.py'),
            ):
                if path.is_file():
                    spec = importlib.util.spec_from_file_location('frp_audit', str(path))
                    audit = importlib.util.module_from_spec(spec)
                    spec.loader.exec_module(audit)
                    audit.try_emit(
                        'enrollment.created',
                        details={'mode': 'manual', 'label': client_name, 'enrollment_id': enrollment_id},
                    )
                    break
        except Exception:
            pass
        return 0

    # Re-check the same gate at issuance: a Server setting or certificate may
    # have changed while the user was filling out the guided service draft.
    compact_host, private_ip_plan = validate_zero_touch_prerequisites(
        cfg, platform, installer, ca_fp
    )

    alloc_mod = load_allocator()
    if alloc_mod is None:
        fail('allocator module is missing')
    # Freeze the qualified resolved installer in the issuer-side record. A
    # merely derived Windows URL must not yield a ticket without a frozen,
    # hash-bound stage-1 that the compact command will need.
    issuance_cfg = remapped_server_cfg(cfg)
    if platform == 'windows':
        issuance_cfg['windows_client_installer_url'] = installer
        if private_ip_plan:
            renderer = getattr(alloc_mod, 'windows_renderer_inputs_from_cfg', None)
            if not callable(renderer) or renderer(issuance_cfg) is None:
                fail('Windows secure stage-1 renderer is unavailable; no ticket was issued')
    else:
        issuance_cfg['client_installer_url'] = installer

    # Identification is collected once. When --client-name was already supplied
    # (guided wrapper), accept a blank --note without a second prompt.
    if is_interactive_stdin() and not client_name:
        client_name, note = prompt_client_identification(None, None)
        reject_control_chars('--client-name', client_name)
        reject_control_chars('--note', note)

    rdp_local = None
    if a.ssh:
        raw_services = [ssh_service(ssh_port)]
    elif a.rdp:
        raw_services = [rdp_service(rdp_port)]
        rdp_local = rdp_port
    else:
        raw_services = load_services_file(a.services_file) if a.services_file else []

    try:
        services = alloc_mod.normalize_services(raw_services)
    except alloc_mod.ServiceValidationError as exc:
        fail(str(exc))

    ssh_pre_port = first_ssh_preflight(services)
    print_client_configuration(client_name, note, services=services, ssh_port=ssh_pre_port)
    if not confirm_client_setup():
        return 0

    compact_host = compact_host if a.one_line else ''
    # Rendering receives only the host proven by the operator's explicit
    # bootstrap setting or the real public TLS probe. Never silently render
    # thousands of characters on the default beginner path.
    render_cfg = dict(cfg)
    if compact_host:
        render_cfg['bootstrap_hostname'] = compact_host
    else:
        render_cfg.pop('bootstrap_hostname', None)

    bootstrap_cfg = str(cfg.get('bootstrap_dir') or '').strip()
    if bootstrap_cfg:
        bootstrap_dir = remap(bootstrap_cfg)
    else:
        bootstrap_dir = enroll_dir.parent / 'bootstrap'

    try:
        ticket, _enroll_record, ticket_record = alloc_mod.issue_bootstrap_ticket(
            enroll_dir,
            bootstrap_dir,
            services,
            ttl,
            note,
            label=client_name,
            cfg=issuance_cfg,
        )
    except Exception as exc:
        if type(exc).__name__ == 'ZeroTouchCapacityError' or 'MAX_ISSUABLE' in str(exc):
            fail(str(exc))
        fail('failed to issue bootstrap ticket: %s' % exc)

    ticket_id = str((ticket_record or {}).get('id') or '')
    short_handle = ''
    stage1_sha256 = ''
    if isinstance(ticket_record, dict):
        short_handle = str(ticket_record.pop('_short_handle', '') or '')
        renderer = ticket_record.get('windows_renderer') or {}
        if isinstance(renderer, dict):
            stage1_sha256 = str(renderer.get('stage1_sha256') or '')
    bootstrap_hostname = str(render_cfg.get('bootstrap_hostname') or '').strip()
    public_hostname = str(render_cfg.get('public_hostname') or '').strip()
    if platform == 'windows':
        print_one_line_windows(
            ticket,
            ttl,
            note,
            public_host,
            control_public,
            allocator,
            ca_fp,
            installer,
            rdp_port=rdp_local,
            client_name=client_name,
            management_only=not services,
            ticket_id=ticket_id,
            bootstrap_hostname=bootstrap_hostname,
            public_hostname=public_hostname,
            cfg=render_cfg,
            short_handle=short_handle,
            stage1_sha256=stage1_sha256,
            private_ip_plan=private_ip_plan,
        )
    else:
        print_one_line(
            ticket,
            ttl,
            note,
            public_host,
            control_public,
            allocator,
            ca_fp,
            installer,
            ssh_pre_port,
            client_name=client_name,
            management_only=not services,
            ticket_id=ticket_id,
            bootstrap_hostname=bootstrap_hostname,
            public_hostname=public_hostname,
            cfg=render_cfg,
            short_handle=short_handle,
            private_ip_plan=private_ip_plan,
        )
    try:
        here = Path(__file__).resolve()
        for path in (
            here.parent.parent / 'lib' / 'frp_audit.py',
            Path('/usr/local/lib/drlink/frp_audit.py'),
        ):
            if path.is_file():
                spec = importlib.util.spec_from_file_location('frp_audit', str(path))
                audit = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(audit)
                audit.try_emit('enrollment.created', details={'label': client_name})
                break
    except Exception:
        pass
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

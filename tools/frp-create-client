def short_url_host_for_cfg(cfg, bootstrap_hostname='', public_hostname=''):
    """Qualify exactly one public FQDN with stock HTTPS trust and /i/ proof.

    Neither `set server bootstrap-hostname` nor `set server public-hostname`
    installs a public certificate. An explicit hostname MUST undergo the
    same real TLS trust/404 proof as an inferred public hostname. Never
    substitute a private-CA DNS shortcut or disable verification to make a
    deceptively short command.
    """
    scfg = load_server_config()
    cfg = cfg if isinstance(cfg, dict) else {}
    explicit = str(cfg.get('bootstrap_hostname') or bootstrap_hostname or '').strip().lower()
    configured = ''
    if scfg is not None:
        try:
            configured = scfg.short_url_hostname(cfg)
        except Exception:
            configured = ''
    candidate = str(
        configured or explicit
        or cfg.get('public_hostname') or cfg.get('public_url_host')
        or public_hostname or ''
    ).strip().lower()
    try:
        if not candidate or not re.fullmatch(r'[a-z0-9][a-z0-9.-]{2,252}', candidate):
            return ''
        if '.' not in candidate or candidate.endswith('.local'):
            return ''
        if scfg is not None:
            candidate = scfg.validate_public_hostname(candidate, required=True)
    except Exception:
        return ''

    # Hermetic tests cannot probe the public internet. Existing source-level
    # tests use this override for explicit DNS; live readiness never does.
    if _test_root():
        return candidate if explicit else ''
    try:
        import ssl
        import urllib.error
        import urllib.request

        class NoRedirect(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, req, fp, code, msg, headers, newurl):
                return None

        url = 'https://%s/i/invalid-qualification-probe' % candidate
        opener = urllib.request.build_opener(
            urllib.request.ProxyHandler({}),
            urllib.request.HTTPSHandler(context=ssl.create_default_context()),
            NoRedirect(),
        )
        try:
            with opener.open(url, timeout=4):
                # Any success or HTML page is not allocator proof.
                return ''
        except urllib.error.HTTPError as exc:
            try:
                return candidate if (exc.code == 404 and
                    exc.read(128).decode('utf-8','replace').strip() ==
                    'bootstrap unavailable') else ''
            finally:
                exc.close()
    except Exception:
        return ''


def private_ca_ip_bootstrap_plan(cfg, ca_fp):
    """Qualify pinned Private-CA bootstrap over a numeric IP without mutating
    the configured FQDN allocator endpoint.

    The FQDN may use the Server's intentionally private CA, so system-trust
    short URLs are unavailable. If the operator-configured public IP also
    appears in the same verified Server leaf, use that IP only for the
    credential's first pinned stage. Stage 1 keeps the original allocator
    URL and uses the pinned CA for later TLS. Never turn a failed FQDN probe
    into an unpinned FQDN command or silently trust a DNS name.
    """
    zt = load_zero_touch()
    pki = load_frp_pki()
    if zt is None or pki is None:
        return None
    allocator = str(cfg.get('allocator_public_url') or '').strip()
    endpoint = zt.private_ca_ip_endpoint(allocator)
    requested_fqdn = ''
    selected_allocator = allocator
    if endpoint is None:
        try:
            parsed = urlparse(allocator)
            if (parsed.scheme != 'https' or not parsed.hostname or not parsed.netloc
                    or parsed.username is not None or parsed.password is not None
                    or parsed.query or parsed.fragment or parsed.path != '/enroll'):
                return None
            # A plain FQDN must remain subject to the stock TLS gate; the IP
            # alternative is restricted to the configured numeric public IP.
            if zt.private_ca_ip_endpoint('https://%s/enroll' % parsed.netloc):
                return None
            requested_fqdn = parsed.hostname
            public_ip = ipaddress.ip_address(
                str(cfg.get('public_ip') or '').strip().strip('[]')
            )
            if public_ip.is_multicast or public_ip.is_unspecified:
                return None
            ip_literal = '[%s]' % public_ip if public_ip.version == 6 else str(public_ip)
            authority = ip_literal + (':%d' % parsed.port if parsed.port and parsed.port != 443 else '')
            selected_allocator = 'https://%s/enroll' % authority
            endpoint = zt.private_ca_ip_endpoint(selected_allocator)
        except (ValueError, TypeError):
            return None
        if endpoint is None:
            return None
    ca = remap(str(cfg.get('tls_ca_cert') or '/etc/drlink/pki/ca.crt'))
    leaf = remap(str(cfg.get('tls_server_cert') or '/etc/drlink/pki/server.crt'))
    try:
        if not ca.is_file() or not leaf.is_file():
            return None
    except OSError:
        return None
    try:
        if pki.fingerprint_from_cert_file(ca) != str(ca_fp or '').lower():
            return None
        pki.verify_cert_signed_by_ca(ca, leaf)
        if not pki.cert_covers_identities(
                leaf, [requested_fqdn] if requested_fqdn else [],
                [endpoint[1].strip('[]')]):
            return None
    except Exception:
        return None
    return {
        'mode': 'private_ca_ip',
        'authority': endpoint[0],
        'allocator': selected_allocator,
        'leaf_sha256': pki.fingerprint_from_cert_file(leaf),
    }


def validate_zero_touch_prerequisites(cfg, platform, installer, ca_fp):
    """Side-effect-free availability gate shared by guided + issuing CLI paths.

    No enrollment IDs/ports are allocated. External HEAD preflight is bounded;
    only an issuer-local PKI with a matching IP SAN qualifies private-CA IP.
    """
    allocator = str(cfg.get('allocator_public_url') or '').strip()
    if not installer:
        if platform == 'windows':
            fail('Windows Agent installer URL is not configured; '
                 'set server windows-installer-url <URL>')
        fail('Agent installer URL is not configured; set server installer-url <URL>')
    if not allocator:
        fail('allocator public URL is not configured; cannot generate Zero-Touch')
    if not allocator.lower().startswith('https://'):
        fail('allocator public URL must be HTTPS')
    if not ca_fp:
        fail('allocator CA SHA256 fingerprint is unavailable; cannot generate a secure command')
    compact_host = short_url_host_for_cfg(cfg)
    private_ip_plan = None
    if not compact_host:
        private_ip_plan = private_ca_ip_bootstrap_plan(cfg, ca_fp)
        if not private_ip_plan:
            fail('Zero-Touch FQDN is not ready: configure publicly trusted HTTPS '
                 'TLS (certificate chain and DNS SAN) on the Server/reverse proxy '
                 'for its configured public or bootstrap hostname. Alternatively '
                 'use a numeric-IP allocator with a valid pinned Private CA and '
                 'matching IP SAN. DNS alone does not establish trust. '
                 'No enrollment ticket was issued.')
    label = 'Windows Agent installer URL' if platform == 'windows' else 'Agent installer URL'
    issuer_ca_file = None
    if private_ip_plan:
        # The private CA was verified above; require actual TLS and HTTP 200
        # using that CA for Server-owned installer hosts, not system-trust
        # (which correctly rejects this privately issued certificate).
        allowed_hosts = {
            urlparse(allocator).hostname,
            urlparse(private_ip_plan['allocator']).hostname,
        }
        if urlparse(installer).hostname in allowed_hosts:
            issuer_ca_file = remap(str(
                cfg.get('tls_ca_cert') or '/etc/drlink/pki/ca.crt'
            ))
    preflight_installer_url(
        installer, label=label, strict_https=not bool(_test_root()),
        ca_file=issuer_ca_file if not _test_root() else None,
    )
    if platform == 'windows' and private_ip_plan:
        module = load_allocator()
        renderer = getattr(module, 'windows_renderer_inputs_from_cfg', None)
        resolved_cfg = remapped_server_cfg(cfg)
        resolved_cfg['windows_client_installer_url'] = installer
        if not callable(renderer) or renderer(resolved_cfg) is None:
            fail('Windows secure stage-1 renderer is unavailable; no ticket was issued')
    return compact_host, private_ip_plan



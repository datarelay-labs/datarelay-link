def parse_args(argv=None):
    p = argparse.ArgumentParser(
        description='Create a short-lived Data Relay Link Agent enrollment code',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            'examples:\n'
            '  # Preferred operator UX (guided, no --options):\n'
            '  sudo drlink\n'
            '  set enrollment zero-touch\n'
            '  set enrollment manual\n'
            '  set enrollment bulk\n'
            '\n'
            '  # This backend tool still accepts internal flags for scripts:\n'
            '  frp-create-client --one-line --ssh --note client-01\n'
            '  frp-create-client --one-line --ssh --client-name seoul-groupware '
            '--note "Seoul office"\n'
            '  frp-create-client --one-line --client-name inventory-only\n'
        ),
    )
    p.add_argument(
        '--ttl',
        default=None,
        metavar='DURATION|SECONDS',
        help=(
            'Enrollment lifetime: duration (30m|1h|4h|1d) or seconds. '
            'Zero-Touch default %s (max %s); Manual Enrollment default 600s (max %s).'
            % (ZERO_TOUCH_DEFAULT_TTL, ZERO_TOUCH_MAX_TTL_TEXT, MAX_ENROLLMENT_TTL_TEXT)
        ),
    )
    p.add_argument('--preflight-zero-touch', action='store_true', help=argparse.SUPPRESS)
    p.add_argument('--note', default='')
    p.add_argument(
        '--client-name',
        '--label',
        dest='client_name',
        default='',
        metavar='NAME',
        help='administrator label seeded at enrollment (does not replace hostname)',
    )
    p.add_argument(
        '--one-line',
        action='store_true',
        help='Print a one-line zero-touch Agent install command',
    )
    p.add_argument(
        '--ssh',
        action='store_true',
        help='SSH convenience service template (127.0.0.1:22)',
    )
    p.add_argument(
        '--ssh-port',
        default=None,
        metavar='PORT',
        help='Local SSH listen port (default 22)',
    )
    p.add_argument(
        '--services-file',
        default='',
        metavar='PATH',
        help='JSON list of services (same schema as FRP_SERVICES_JSON)',
    )
    p.add_argument(
        '--platform',
        choices=('linux', 'macos', 'windows'),
        default='linux',
        help='Agent platform for the one-line command (default: linux)',
    )
    p.add_argument(
        '--rdp',
        action='store_true',
        help='Windows RDP convenience service (custom TCP to 127.0.0.1:3389)',
    )
    p.add_argument(
        '--rdp-port',
        default=None,
        metavar='PORT',
        help='Local RDP listen port (default 3389)',
    )
    return p.parse_args(argv)



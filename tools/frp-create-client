def entry_authority_for_cfg(cfg):
    """One configured HTTPS authority for both public and private entry TLS."""
    zt = load_zero_touch()
    allocator = urlparse(str(cfg.get('allocator_public_url') or ''))
    if zt is None or allocator.scheme != 'https' or not allocator.netloc:
        raise ValueError('HTTPS allocator public URL is required')
    if allocator.username or allocator.password or allocator.query or allocator.fragment:
        raise ValueError('invalid allocator public URL')
    authority = str(cfg.get('bootstrap_hostname') or allocator.netloc).strip()
    return zt.entry_authority(authority)


def validate_zero_touch_prerequisites(cfg, platform, installer, ca_fp):
    """Verify entry routing and downstream installer readiness without issuance."""
    import ssl
    import urllib.error
    import urllib.request
    zt = load_zero_touch()
    try:
        authority = entry_authority_for_cfg(cfg)
    except ValueError as exc:
        fail(str(exc) + '; no enrollment was issued')
    if platform not in ('linux', 'macos', 'windows') or not installer:
        fail('Agent platform and HTTPS installer are required; no enrollment was issued')
    allocator = str(cfg.get('allocator_public_url') or '')
    ca_file = remap(str(cfg.get('tls_ca_cert') or '/etc/drlink/pki/ca.crt'))
    if not ca_fp or not ca_file.is_file() or fingerprint_from_cert(ca_file) != ca_fp:
        fail('allocator CA SHA256 fingerprint is unavailable or inconsistent; no enrollment was issued')
    if not _test_root():
        class NoRedirect(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, req, fp, code, msg, headers, newurl):
                return None
        # This probe carries no credential. Like the fixed Stage-0 command it
        # intentionally tests routing, not TLS peer identity.
        opener = urllib.request.build_opener(
            urllib.request.ProxyHandler({}),
            urllib.request.HTTPSHandler(context=ssl._create_unverified_context()),
            NoRedirect())
        try:
            with opener.open('https://' + authority + '/ZT0000', timeout=5):
                fail('unexpected Bootstrap route response; no enrollment was issued')
        except urllib.error.HTTPError as exc:
            try:
                if exc.code != 404 or exc.read(128).strip() != b'bootstrap unavailable':
                    fail('Bootstrap root route is not ready; no enrollment was issued')
            finally:
                exc.close()
        except (OSError, ValueError):
            fail('Bootstrap HTTPS endpoint is not reachable; no enrollment was issued')
    preflight_installer_url(
        installer, label='Agent installer URL', strict_https=not bool(_test_root()),
        ca_file=ca_file if zt.same_https_origin(installer, allocator) and not _test_root() else None)
    return authority



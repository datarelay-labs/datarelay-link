def _is_forbidden_public_installer_url(url):
    """Former official DataRelay/fatedier public artifact URLs are forbidden."""
    qa = load_qualified_artifacts()
    if qa is not None and hasattr(qa, 'is_forbidden_public_installer_url'):
        return bool(qa.is_forbidden_public_installer_url(url))
    text = str(url or '').strip().lower()
    if not text:
        return False
    return (
        'raw.githubusercontent.com' in text
        or 'github.com/datarelay-labs' in text
        or 'github.com/fatedier' in text
    )


def _installer_unavailable_message(platform='linux'):
    qa = load_qualified_artifacts()
    plat = 'windows' if str(platform or '').strip().lower() == 'windows' else 'linux'
    arch = 'amd64' if plat == 'windows' else 'any'
    if qa is not None:
        return qa.missing_artifact_error(plat, arch)
    return (
        'ERROR:\n'
        'Required qualified Agent artifact is not available from this DRLink Server.\n'
        '\n'
        'Run:\n'
        '  system diagnostics\n'
        '\n'
        'Reinstall or update the DRLink Server package containing\n'
        'the required qualified artifacts.\n'
        '\n'
        'No changes were applied.\n'
    )


def fail_closed_installer(platform='linux'):
    msg = _installer_unavailable_message(platform)
    sys.stderr.write(msg if str(msg).endswith('\n') else '%s\n' % msg)
    raise SystemExit(2)


def server_local_installer_url(cfg, *, windows=False):
    """Derive the canonical Server-local Agent installer URL. Never public."""
    platform = 'windows' if windows else 'linux'
    qa = load_qualified_artifacts()
    if qa is None:
        fail_closed_installer(platform)
    allocator = str((cfg or {}).get('allocator_public_url') or '').strip()
    try:
        url = qa.agent_installer_url(allocator, platform)
    except Exception:
        fail_closed_installer(platform)
    if not url or _is_forbidden_public_installer_url(url):
        fail_closed_installer(platform)
    return url


def default_client_installer_url(cfg=None):
    """Canonical Server-local Linux Agent installer URL, or empty.

    Never returns a public GitHub/DataRelay/fatedier fallback. Callers that
    must fail closed should use resolve_configured_installer_url().
    """
    if not cfg:
        return ''
    try:
        return server_local_installer_url(cfg, windows=False)
    except SystemExit:
        return ''


def default_windows_client_installer_url(cfg=None):
    """Canonical Server-local Windows Agent installer URL, or empty."""
    if not cfg:
        return ''
    try:
        return server_local_installer_url(cfg, windows=True)
    except SystemExit:
        return ''


def resolve_configured_installer_url(cfg, *, windows=False):
    """Resolve Managed Host installer URL from Server-local artifacts only.

    Configured Server-local and unrelated administrator URLs are preserved.
    Missing URLs and former official public DataRelay/fatedier URLs are
    derived from allocator_public_url. Fail closed if that is impossible.
    """
    platform = 'windows' if windows else 'linux'
    if not isinstance(cfg, dict):
        fail_closed_installer(platform)
    key = 'windows_client_installer_url' if windows else 'client_installer_url'
    configured = str(cfg.get(key, '') or '').strip()
    if configured and not _is_forbidden_public_installer_url(configured):
        return configured
    return server_local_installer_url(cfg, windows=windows)


def preflight_installer_url(
        url, *, label='Agent installer', strict_https=False, ca_file=None):
    """Bounded read-only HTTPS proof before issuing a one-time ticket.

    The bundled Server artifact handler supports GET but can answer HEAD
    501. Fall back only for HEAD 405/501, using the same strict TLS context
    (stock OS trust or the already locally verified issuer CA). Read at most
    one payload byte; never execute or follow redirects.
    """
    import ssl
    import urllib.error
    import urllib.request

    url = str(url or '').strip()
    if not url:
        fail('%s is not configured; no enrollment ticket was issued' % label)
    parsed = urlparse(url)
    if parsed.scheme.lower() != 'https' or not parsed.hostname or parsed.username or parsed.password:
        fail('%s must be an HTTPS URL without credentials; no enrollment ticket was issued' % label)
    if parsed.fragment:
        fail('%s must not contain a fragment; no enrollment ticket was issued' % label)
    try:
        if ca_file is not None:
            ctx = ssl.create_default_context(cafile=str(ca_file))
        else:
            ctx = ssl.create_default_context()
    except (OSError, ssl.SSLError, ValueError):
        fail('%s pinned CA is invalid; no enrollment ticket was issued' % label)

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({}),
        urllib.request.HTTPSHandler(context=ctx),
        NoRedirect(),
    )
    for method in ('HEAD', 'GET'):
        req = urllib.request.Request(url, method=method)
        req.add_header('User-Agent', 'DataRelayLink-InstallerPreflight/2.4')
        try:
            with opener.open(req, timeout=5) as resp:
                code = int(getattr(resp, 'status', None) or resp.getcode())
                if strict_https and code != 200:
                    fail('%s returned HTTPS %s, expected 200; no enrollment ticket was issued'
                         % (label, code))
                if method == 'GET' and not resp.read(1):
                    fail('%s returned an empty installer response; no enrollment ticket was issued'
                         % label)
                return
        except urllib.error.HTTPError as exc:
            code = exc.code
            exc.close()
            if method == 'HEAD' and code in (405, 501):
                continue
            if strict_https or code == 404:
                fail('%s URL returned HTTPS %s: %s; no enrollment ticket was issued'
                     % (label, code, url))
            return
        except (OSError, ValueError) as exc:
            if strict_https:
                fail('%s HTTPS TLS/reachability check failed: %s; no enrollment ticket was issued. '
                     'Verify the certificate chain and DNS/IP SAN before creating the Agent.'
                     % (label, type(exc).__name__))
            return
    fail('%s does not support GET after HEAD 405/501; no enrollment ticket was issued' % label)



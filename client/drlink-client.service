[Unit]
Description=Data Relay Link Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Clear stale runtime_verified and push DEGRADED before frpc starts so a short
# OS reboot that never flips Server connected cannot keep false HEALTHY.
# Leading '-' keeps unit start best-effort if management is offline.
ExecStartPre=-/usr/bin/python3 -c "import sys; sys.path.insert(0, '/usr/local/lib/drlink'); from drlink_v24 import invalidate_runtime_verification_for_restart; invalidate_runtime_verification_for_restart()"
ExecStart=/usr/local/bin/frpc -c /etc/frp/frpc.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
